# DroidSpaces GKI configuration fragment
# Based on the official DroidSpaces GKI kernel configuration guide.
# Merge this fragment into the target GKI configuration at build time.
# Do not edit arch/arm64/configs/gki_defconfig.

# Required: IPC
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y

# Required: namespaces
CONFIG_NAMESPACES=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y

# Required: device filesystem
CONFIG_DEVTMPFS=y

# Required: enhanced NAT support
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y

# Optional but recommended: Docker compatibility
CONFIG_USER_NS=y

# Optional but recommended: IPv6 NAT (NAT66)
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y

# Optional but recommended: UFW
CONFIG_IP_NF_TARGET_REJECT=y
CONFIG_IP6_NF_TARGET_REJECT=y
CONFIG_NETFILTER_XT_TARGET_LOG=y
CONFIG_NETFILTER_XT_MATCH_RECENT=y

# Optional but recommended: Fail2ban
CONFIG_IP_SET=y
CONFIG_IP_SET_HASH_IP=y
CONFIG_IP_SET_HASH_NET=y
CONFIG_NETFILTER_XT_SET=y

# Optional but recommended: tmpfs xattr and POSIX ACL (NixOS)
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y

# Requested additional kernel features
CONFIG_NTSYNC=y
CONFIG_BT_HCIVHCI=y
CONFIG_DRM_LINDROID_EVDI=y
CONFIG_REKERNEL=y

# Deliberately not enabled: these change GKI kABI and can break vendor modules.
# CONFIG_CFS_BANDWIDTH is not set
# CONFIG_CGROUP_PIDS is not set
